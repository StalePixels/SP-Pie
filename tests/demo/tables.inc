; Screen byte of a line that slopes one way, indexed by the picture line number mod 8.
tab_plus:
        DB 0xC0,0x81,0x03,0x06,0x0C,0x18,0x30,0x60
; Screen byte of a line that slopes the other way, indexed the same way.
tab_minus:
        DB 0xC0,0x60,0x30,0x18,0x0C,0x06,0x03,0x81
; ULAplus palette 0: the 48K colours, normal in CLUT 0 and 2, bright in CLUT 1 and 3.
